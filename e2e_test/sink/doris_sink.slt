# Arrow + full type coverage. This auto-creates a Doris table covering the RisingWave types the
# sink supports, and loads through `doris.format = 'arrow'` — the Arrow IPC path. It is also the
# regression test for the Arrow routing bug where `Jsonb` columns (whose Arrow field is a `Utf8`
# extension) were routed to a fallback that rejected them.
#
# `DECIMAL` is covered here too: Doris historically crashed the BE on a decimal arrow load
# (`DataTypeDecimalSerDe::read_column_from_arrow` segfaulted on a Utf8 decimal array), but the
# Doris fix that accepts decimal-as-string on the Arrow path is now required for this case to pass.
statement ok
CREATE TABLE t6_arrow (v1 int primary key, v2 smallint, v3 bigint, v4 real, v5 float, v6 varchar, v7 date, v8 timestamp, v9 boolean, v10 jsonb, v11 decimal, v12 time, v13 interval, v14 bytea, v15 rw_int256, v16 struct<a int, b varchar>, v17 varchar[], v18 map(varchar, int));

statement ok
CREATE MATERIALIZED VIEW mv6_arrow AS SELECT * FROM t6_arrow;

statement ok
CREATE SINK s6_arrow
FROM
    mv6_arrow WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.query_url = 'mysql://doris-server:9030',
    doris.stream_load_url = 'http://doris-server:8040',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_arrow_table',
    doris.replication_num = '1',
    doris.format = 'arrow',
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO t6_arrow VALUES (1, 2, 3, 4.5, 5.5, 'arrow', '2024-01-02', '2024-01-02 03:04:05', true, '{"a":1}', 1234567.89, '18:20:49', interval '4 hour', decode('De00BeEf', 'hex'), '123456789012345678901234567890'::rw_int256, row(1, 's'), array['a','b'], map {'k1': 1});

statement ok
FLUSH;

# The arrow load committed. Check the row landed with the values that matter (id, jsonb, the
# complex types, the decimal, the text fallbacks) rather than every column, keeping the assertion
# robust to Doris text casts.
system ok retry 10 backoff 1s
test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "select count(*) from demo.demo_arrow_table;")" = "1" && test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "select v11 = 1234567.89 from demo.demo_arrow_table;")" = "1"

statement ok
DROP SINK s6_arrow;

statement ok
DROP MATERIALIZED VIEW mv6_arrow;

statement ok
DROP TABLE t6_arrow;

# Append-only auto-create with no primary key. The sink omits `DISTRIBUTED BY` from the DDL, so
# Doris auto-generates `DISTRIBUTED BY RANDOM BUCKETS AUTO` and auto-sizes the bucket count
# (instead of the sink hashing on an arbitrary key-able column, which could skew). The assertion
# below checks the created table carries that auto-generated distribution.
statement ok
CREATE TABLE t6_apnd (v1 int, v2 varchar, v3 bigint);

statement ok
CREATE MATERIALIZED VIEW mv6_apnd AS SELECT * FROM t6_apnd;

statement ok
CREATE SINK s6_apnd
FROM
    mv6_apnd WITH (
    connector = 'doris',
    type = 'append-only',
    force_append_only = 'true',
    doris.url = 'http://doris-server:8030',
    doris.query_url = 'mysql://doris-server:9030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_auto_append_table',
    doris.replication_num = '1',
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO t6_apnd VALUES (1, 'a', 100), (2, 'b', 200);

statement ok
FLUSH;

# The append-only no-pk table was auto-distributed (`DISTRIBUTED BY RANDOM BUCKETS AUTO`), and
# both rows landed. This asserts the sink omitted `DISTRIBUTED BY` so Doris generated RANDOM
# (an explicit `DISTRIBUTED BY HASH(...) BUCKETS AUTO` would not match).
system ok retry 10 backoff 1s
test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "select count(*) from demo.demo_auto_append_table;")" = "2" && test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "show create table demo.demo_auto_append_table;" | grep -c 'DISTRIBUTED BY RANDOM')" = "1"

statement ok
DROP SINK s6_apnd;

statement ok
DROP MATERIALIZED VIEW mv6_apnd;

statement ok
DROP TABLE t6_apnd;

# Auto-RANGE partition: `partition_by = 'month(v2)'` emits
# `AUTO PARTITION BY RANGE(date_trunc(`v2`, 'month'))()`. This exercises the RANGE form (which
# keeps `BUCKETS AUTO`) and the date-trunc granularity. `demo_auto_range_table` is not
# pre-created; the sink auto-creates it. The partition column `v2` must be a key column (Doris
# requires partition columns to be key columns), so it is part of the sink's `primary_key`.
statement ok
CREATE TABLE t6_range (v1 int, v2 timestamp, PRIMARY KEY (v1, v2));

statement ok
CREATE MATERIALIZED VIEW mv6_range AS SELECT * FROM t6_range;

statement ok
CREATE SINK s6_range
FROM
    mv6_range WITH (
    connector = 'doris',
