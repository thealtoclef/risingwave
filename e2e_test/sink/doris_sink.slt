# A small `doris.max_batch_size_bytes` forces the writer to split one chunk across several stream
# loads. Every row must still land exactly once: each split is an independently committed load, and
# the sink verifies each one's loaded-row accounting separately.
statement ok
CREATE TABLE t6_split (v1 int primary key, v2 varchar);

statement ok
CREATE MATERIALIZED VIEW mv6_split AS SELECT * FROM t6_split;

statement ok
CREATE SINK s6_split
FROM
    mv6_split WITH (
    connector = 'doris',
    type = 'append-only',
    force_append_only = 'true',
    doris.url = 'http://doris-server:8030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_split_table',
    doris.max_batch_size_bytes = '64'
);

statement error must be greater than 0
ALTER SINK s6_split CONNECTOR WITH (
    doris.max_batch_size_bytes = '0'
);

# Each row's JSON is roughly 40 bytes, so a 64-byte cap admits one row per load and the three rows
# below are split across three separate Doris loads.
statement ok
INSERT INTO t6_split VALUES (1, 'aaaaaaaaaaaaaaaaaaaa'), (2, 'bbbbbbbbbbbbbbbbbbbb'), (3, 'cccccccccccccccccccc');

statement ok
FLUSH;

# `commit_checkpoint_interval` > 1 batches several checkpoints into one Doris stream load, which
# needs sink decoupling. Deliberately no `DROP SINK` for this case: dropping a decoupled sink does
# not flush it, so the rows must land through natural interval commits during the run. The CI
# script asserts the contents with a bounded retry loop to absorb the decoupled reader's lag.
statement ok
set sink_decouple = true;

statement ok
CREATE TABLE t6_decoupled (v1 int primary key, v2 varchar);

statement ok
CREATE MATERIALIZED VIEW mv6_decoupled AS SELECT * FROM t6_decoupled;

statement ok
CREATE SINK s6_decoupled
FROM
    mv6_decoupled WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_decoupled_table',
    commit_checkpoint_interval = '2'
);

# Four insert/update rounds, so more than one interval window closes during the run. Rows 1 and 2
# are rewritten in later rounds, which puts repeated primary keys inside a single stream load —
# the one case where the sink's loaded-rows accounting check could legitimately diverge if Doris
# counted merge-on-write dedup before reporting `NumberLoadedRows`.
statement ok
INSERT INTO t6_decoupled VALUES (1, 'r1'), (2, 'r1');

statement ok
FLUSH;

statement ok
UPDATE t6_decoupled SET v2 = 'r2' WHERE v1 = 1;

statement ok
FLUSH;

statement ok
INSERT INTO t6_decoupled VALUES (3, 'r3');

statement ok
FLUSH;

statement ok
UPDATE t6_decoupled SET v2 = 'r4' WHERE v1 = 2;

statement ok
FLUSH;

# Both new options must be alterable on the fly: `commit_checkpoint_interval` to retune commit
# frequency, and `doris.strict_mode` as the documented escape hatch for a sink stalled on an
# unconvertible row. Both are altered in one statement.
#
# This runs against the *decoupled* sink on purpose. A sink created with `sink_decouple = false`
# uses the bounded in-memory log store, which cannot rewind, so `ALTER SINK ... CONNECTOR WITH`
# applies the change by deliberately triggering a cluster recovery — and the statement itself then
# races that recovery, failing with `failed to collect barrier` often enough to be flaky. A
# decoupled sink rewinds its log reader and applies the change in place, so this is deterministic.
#
# The rounds above have already run at `commit_checkpoint_interval = 2`, so lowering it to 1 here
# does not weaken that coverage. Rewinding re-sends rows the sink may have already committed, which
# is idempotent on this UNIQUE KEY merge-on-write table and leaves the expected contents unchanged.
statement ok
ALTER SINK s6_decoupled CONNECTOR WITH (
    commit_checkpoint_interval = '1',
    doris.strict_mode = 'false'
);

query I
select count(*)
from rw_sinks
where name = 's6_decoupled'
  and definition ILIKE '%commit_checkpoint_interval = ''1''%'
  and definition ILIKE '%doris.strict_mode = ''false''%';
----
1

