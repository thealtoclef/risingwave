# The `s6_decoupled` case near the end of this file deliberately leaves its objects behind: `DROP
# SINK` does not drain a decoupled sink's log store, and nothing a test can issue does either, so
# its rows have to land through natural interval commits while this file runs and the CI script
# asserts them afterwards. Drop those leftovers up front so the file can be re-run in place.
statement ok
DROP SINK IF EXISTS s6_decoupled;

statement ok
DROP MATERIALIZED VIEW IF EXISTS mv6_decoupled;

statement ok
DROP TABLE IF EXISTS t6_decoupled;

statement ok
set sink_decouple = false;

statement ok
CREATE TABLE t6 (v1 int primary key, v2 smallint, v3 bigint, v4 real, v5 float, v6 varchar, v7 date, v8 timestamp, v9 boolean, v10 jsonb);

statement ok
CREATE MATERIALIZED VIEW mv6 AS SELECT * FROM t6;

statement ok
CREATE SINK s6
FROM
    mv6 WITH (
    connector = 'doris',
    type = 'append-only',
    doris.url = 'http://doris-server:8030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table='demo_bhv_table',
    force_append_only='true'
);

# An invalid value must be rejected by the frontend, which validates before issuing any barrier, so
# this is safe to run against a sink using the in-memory log store. Altering to a *valid* value is
# covered further down on the decoupled sink; see the comment there for why it cannot be done here.
statement error must be greater than 0
ALTER SINK s6 CONNECTOR WITH (
    commit_checkpoint_interval = '0'
);

statement ok
INSERT INTO t6 VALUES (1, 1, 1, 1.1, 1.2, 'test', '2013-01-01', '2013-01-01 01:01:01' , false, '{"a":1}');

statement ok
FLUSH;

# Same `doris.url` (FE on 8030) for schema, but `doris.stream_load_url` overrides the
# stream-load endpoint so the sink writes directly to the BE on 8040 and skips the
# FE → BE 307 redirect. `doris.url` is still used for the `/_schema` lookup during sink
# creation, so the FE must remain reachable for that purpose.
statement ok
CREATE TABLE t6_direct (v1 int primary key, v2 smallint, v3 bigint, v4 real, v5 float, v6 varchar, v7 date, v8 timestamp, v9 boolean, v10 jsonb);

statement ok
CREATE MATERIALIZED VIEW mv6_direct AS SELECT * FROM t6_direct;

statement ok
CREATE SINK s6_direct
FROM
    mv6_direct WITH (
    connector = 'doris',
    type = 'append-only',
    doris.url = 'http://doris-server:8030',
    doris.stream_load_url = 'http://doris-server:8040',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_stream_load_url_table',
    force_append_only = 'true'
);

statement ok
INSERT INTO t6_direct VALUES (2, 2, 2, 2.1, 2.2, 'direct', '2014-02-02', '2014-02-02 02:02:02', true, '{"b":2}');

statement ok
FLUSH;

statement ok
CREATE TABLE t6_variant (id int primary key, v jsonb);

statement ok
CREATE MATERIALIZED VIEW mv6_variant AS SELECT * FROM t6_variant;

statement ok
CREATE SINK s6_variant
FROM
    mv6_variant WITH (
    connector = 'doris',
    type = 'append-only',
