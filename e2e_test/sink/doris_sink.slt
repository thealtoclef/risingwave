    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_auto_range_table',
    doris.replication_num = '1',
    partition_by = 'month(v2)',
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO t6_range VALUES (1, '2024-01-15 10:00:00'), (2, '2024-02-20 11:30:00');

statement ok
FLUSH;

system ok retry 10 backoff 1s
test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "select count(*) from demo.demo_auto_range_table;")" = "2"

statement ok
DROP SINK s6_range;

statement ok
DROP MATERIALIZED VIEW mv6_range;

statement ok
