statement ok
INSERT INTO t6_variant VALUES (1, '{"nested":[1,2]}');

statement ok
FLUSH;

# Auto-create: the target Doris table `demo_auto_create_table` is NOT pre-created by the CI
# setup. Creating this upsert sink should auto-create the database (if missing) and a
# UNIQUE KEY table over the MySQL-protocol port before the sink starts loading.
statement ok
CREATE TABLE t6_auto (v1 int primary key, v2 varchar, v3 bigint);

statement ok
CREATE MATERIALIZED VIEW mv6_auto AS SELECT * FROM t6_auto;

statement ok
CREATE SINK s6_auto
FROM
    mv6_auto WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.query_url = 'mysql://doris-server:9030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_auto_create_table',
    doris.replication_num = '1',
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO t6_auto VALUES (1, 'auto', 100);

statement ok
FLUSH;

# Auto-create with `partition_by` in the bare (LIST) form emits
# `AUTO PARTITION BY LIST(`v1`, `v2`)()`, so the auto-created table is partitioned on the
# enumerated `(v1, v2)` key values. The sink's partition-column validation runs before any DDL
# (both columns exist in the sink schema, are key columns, and are LIST-allowable types).
statement ok
CREATE TABLE t6_part (v1 int primary key, v2 varchar, v3 bigint);

statement ok
CREATE MATERIALIZED VIEW mv6_part AS SELECT * FROM t6_part;

statement ok
CREATE SINK s6_part
FROM
    mv6_part WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1,v2',
    doris.url = 'http://doris-server:8030',
    doris.query_url = 'mysql://doris-server:9030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_auto_partition_table',
    doris.replication_num = '1',
    partition_by = 'v1,v2',
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO t6_part VALUES (1, 'a', 100), (2, 'b', 200);

statement ok
FLUSH;

# The upsert auto-LIST table is a UNIQUE KEY table, which cannot use RANDOM distribution, so the
# sink sizes the buckets from the alive BE count: `DISTRIBUTED BY HASH(`v1`,`v2`) BUCKETS <n>`.
system ok retry 10 backoff 1s
test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "show create table demo.demo_auto_partition_table;" | grep -c 'DISTRIBUTED BY HASH')" = "1"

# TIMESTAMPTZ: RisingWave's `timestamptz` value should land in Doris's native `TIMESTAMPTZ`
# column (Doris 4.x) with the underlying UTC instant preserved. Doris stores in UTC and
# re-renders in the session timezone at read time. The encoder emits RFC3339 with `Z` so
# Doris interprets the string as the correct UTC instant instead of using the session TZ.
statement ok
CREATE TABLE t6_tstz (v1 int primary key, v2 timestamptz);

statement ok
CREATE MATERIALIZED VIEW mv6_tstz AS SELECT * FROM t6_tstz;

statement ok
CREATE SINK s6_tstz
FROM
    mv6_tstz WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_tstz_table'
);

statement ok
INSERT INTO t6_tstz VALUES (1, '2024-01-02 03:04:05.123456+00:00'::timestamptz);

statement ok
FLUSH;

# An upsert sink whose schema covers only part of the Doris table would replace the whole row on
# every update, silently resetting the columns it never mentions. That is rejected unless partial
# update is enabled.
statement ok
CREATE TABLE t6_partial (v1 int primary key, v2 varchar);

statement ok
CREATE MATERIALIZED VIEW mv6_partial AS SELECT * FROM t6_partial;

statement error doris.partial_update
CREATE SINK s6_partial_rejected
FROM
    mv6_partial WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_partial_update_table'
);

# With `doris.partial_update` on, only `v1`/`v2` are sent, so `v3` keeps the value the CI fixture
# seeded. This also covers the `columns` request header, which Doris requires for partial updates.
statement ok
CREATE SINK s6_partial
FROM
    mv6_partial WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_partial_update_table',
    doris.partial_update = 'true'
);

statement ok
INSERT INTO t6_partial VALUES (1, 'patched');

statement ok
FLUSH;

# A Doris integer column narrower than the RisingWave one is rejected: Doris would store an
# out-of-range value as NULL and still report the load as a success.
statement ok
CREATE TABLE t6_narrow (v1 int primary key, v2 int);

statement ok
CREATE MATERIALIZED VIEW mv6_narrow AS SELECT * FROM t6_narrow;

statement error Column type don't match
CREATE SINK s6_narrow
FROM
    mv6_narrow WITH (
    connector = 'doris',
    type = 'append-only',
    force_append_only = 'true',
