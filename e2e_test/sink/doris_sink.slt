# Auto schema change: a `CREATE SINK ... FROM <table>` with `auto.schema.change = 'true'`. Adding
# and dropping a column on the source table must be applied to the Doris target by the sink
# coordinator via `ALTER TABLE ... ADD/DROP COLUMN`.
statement ok
CREATE TABLE t6_schema (v1 int primary key, v2 varchar);

statement ok
CREATE SINK s6_schema
FROM
    t6_schema WITH (
    connector = 'doris',
    type = 'upsert',
    primary_key = 'v1',
    doris.url = 'http://doris-server:8030',
    doris.query_url = 'mysql://doris-server:9030',
    doris.user = 'users',
    doris.password = '123456',
    doris.database = 'demo',
    doris.table = 'demo_schema_change_table',
    doris.replication_num = '1',
    auto.schema.change = 'true',
    create_table_if_not_exists = 'true'
);

statement ok
INSERT INTO t6_schema VALUES (1, 'a');

statement ok
FLUSH;

# Add a column: the coordinator should ALTER the Doris table to add `v3`.
statement ok
ALTER TABLE t6_schema ADD COLUMN v3 int;

statement ok
FLUSH;

# The Doris target now has the added `v3` column.
system ok retry 10 backoff 1s
test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "select count(*) from information_schema.columns where table_schema='demo' and table_name='demo_schema_change_table' and column_name='v3';")" = "1"

statement ok
ALTER TABLE t6_schema DROP COLUMN v3;

statement ok
FLUSH;

# The Doris target has dropped `v3` again.
system ok retry 10 backoff 1s
test "$(mysql -uroot -N -B -h doris-server -P 9030 -e "select count(*) from information_schema.columns where table_schema='demo' and table_name='demo_schema_change_table' and column_name='v3';")" = "0"

statement ok
DROP SINK s6_schema;

statement ok
DROP TABLE t6_schema;

# `s6_decoupled` / `mv6_decoupled` / `t6_decoupled` are intentionally left in place: the CI script
# asserts the Doris contents after this file finishes, and dropping a decoupled sink does not flush
# it. Cleanup relies on container teardown in CI, or `./risedev slt-clean` locally.
