control substitution on

# Slow serial backfill lets the test checkpoint a scanned prefix, change both scanned and
# unscanned rows, and recover before completing the snapshot. ICU orders a before B.
system ok
PGDATABASE=${PGDATABASE:-postgres} psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid) FROM pg_replication_slots
    WHERE slot_name = 'collated_recovery_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots
    WHERE slot_name = 'collated_recovery_slot';
    DROP PUBLICATION IF EXISTS collated_recovery_pub;
    DROP TABLE IF EXISTS public.collated_recovery_t;
    CREATE TABLE public.collated_recovery_t (k varchar COLLATE \"und-x-icu\" PRIMARY KEY, v int);
    INSERT INTO public.collated_recovery_t VALUES ('a', 10), ('B', 20);
    INSERT INTO public.collated_recovery_t
    SELECT (CASE WHEN i < 998 THEN 'C' ELSE 'c' END) || lpad(i::text, 4, '0'), 0
    FROM generate_series(0, 999) AS i;
    CREATE PUBLICATION collated_recovery_pub FOR TABLE public.collated_recovery_t;
    "

statement ok
create source collated_recovery_source with (
    connector = 'postgres-cdc',
    hostname = '${PGHOST:localhost}',
    port = '${PGPORT:5432}',
    username = '${PGUSER:$USER}',
    password = '${PGPASSWORD:}',
    database.name = '${PGDATABASE:postgres}',
    schema.name = 'public',
    publication.name = 'collated_recovery_pub',
    slot.name = 'collated_recovery_slot'
);

statement ok
set backfill_rate_limit = 1;

statement ok
create table collated_recovery_t (k varchar primary key, v int)
with (backfill.parallelism = 0, snapshot.batch_size = 2)
from collated_recovery_source table 'public.collated_recovery_t';

query I retry 60 backoff 1s
select count(*) from collated_recovery_t where k = 'B';
----
1

statement ok
alter table collated_recovery_t set backfill_rate_limit = 0;

# Keep the cursor at B or an uppercase C key: source order puts a/aa before it,
# while byte order puts them after it. Neither lowercase tail key may be scanned.
query I
select count(*) from collated_recovery_t where k in ('c0998', 'c0999');
----
0

system ok
PGDATABASE=${PGDATABASE:-postgres} psql -v ON_ERROR_STOP=1 -c "
    UPDATE public.collated_recovery_t SET v = 99 WHERE k = 'a';
    DELETE FROM public.collated_recovery_t WHERE k = 'B';
    INSERT INTO public.collated_recovery_t VALUES ('aa', 55);
    UPDATE public.collated_recovery_t SET v = 77 WHERE k = 'c0999';
    DELETE FROM public.collated_recovery_t WHERE k = 'c0998';
    "

# These changes must arrive while the snapshot is paused; resuming cannot repair a lost update.
query TI retry 60 backoff 1s
select k, v from collated_recovery_t where k in ('a', 'aa', 'B') order by k;
----
a 99
aa 55

statement ok
flush;

statement ok
recover;

query I
select count(*) from collated_recovery_t where k in ('c0998', 'c0999');
----
0

system ok
PGDATABASE=${PGDATABASE:-postgres} psql -v ON_ERROR_STOP=1 -c "
    UPDATE public.collated_recovery_t SET v = 100 WHERE k = 'a';
    DELETE FROM public.collated_recovery_t WHERE k = 'aa';
    "

query TI retry 60 backoff 1s
select k, v from collated_recovery_t where k in ('a', 'aa', 'B') order by k;
----
a 100

statement ok
alter table collated_recovery_t set backfill_rate_limit = 10000;

query II retry 60 backoff 1s
select count(*), sum(v) from collated_recovery_t;
----
1000 177

query TI
select k, v from collated_recovery_t where k in ('a', 'aa', 'B', 'c0998', 'c0999') order by k;
----
a 100
c0999 77

statement ok
drop source collated_recovery_source cascade;

statement ok
set backfill_rate_limit = default;

sleep 2s

system ok
PGDATABASE=${PGDATABASE:-postgres} psql -v ON_ERROR_STOP=1 -c "
    SELECT pg_terminate_backend(active_pid) FROM pg_replication_slots
    WHERE slot_name = 'collated_recovery_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots
    WHERE slot_name = 'collated_recovery_slot';
    DROP PUBLICATION IF EXISTS collated_recovery_pub;
    DROP TABLE IF EXISTS public.collated_recovery_t;
    "
