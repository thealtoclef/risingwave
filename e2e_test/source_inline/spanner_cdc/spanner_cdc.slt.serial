# =============================================================================
# PART 5: TABLE CREATED AFTER THE SOURCE
# The FOR ALL change stream picks up a table created while the source runs.
# =============================================================================

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE orders (id STRING(MAX) NOT NULL, product_id STRING(MAX), quantity INT64, status STRING(MAX)) PRIMARY KEY (id)"

