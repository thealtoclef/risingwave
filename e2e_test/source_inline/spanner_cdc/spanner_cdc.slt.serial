# =============================================================================
# PART 7: PARALLEL BACKFILL WITH CHANGES WHILE IT RUNS
# Many rows over several splits (INT64 keys with negatives and gaps give even
# splits; STRING keys give uneven splits), with updates, deletes and inserts
# spread over the key range issued while the rate-limited backfill runs. The
# final state is fixed by the statements alone, whatever their interleaving
# with the split reads, so any row lost or left stale at a split boundary or in
# the snapshot-to-stream handoff shows up in the count and the sum.
# A rate limit of 0 is not used: a paused v2 backfill resumes only after its
# actor is rebuilt.
# =============================================================================

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE handoff_int (id INT64 NOT NULL, v INT64) PRIMARY KEY (id)"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE handoff_str (id STRING(MAX) NOT NULL, n INT64, v INT64) PRIMARY KEY (id)"

# ids -150..-51, 1..50 and 1000..1049, with v = id.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO handoff_int (id, v) SELECT x, x FROM UNNEST(ARRAY_CONCAT(GENERATE_ARRAY(-150, -51), GENERATE_ARRAY(1, 50), GENERATE_ARRAY(1000, 1049))) AS x"

# ids 'k000'..'k199', with n = v = the index.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO handoff_str (id, n, v) SELECT FORMAT('k%03d', x), x, x FROM UNNEST(GENERATE_ARRAY(0, 199)) AS x"

statement ok
SET backfill_rate_limit = 5;

statement ok
CREATE TABLE t_handoff_int (*) WITH (
    backfill.parallelism = 3,
    backfill.num_rows_per_split = 20,
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'handoff_int';

statement ok
CREATE TABLE t_handoff_str (*) WITH (
    backfill.parallelism = 3,
    backfill.num_rows_per_split = 20,
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'handoff_str';

statement ok
SET backfill_rate_limit TO DEFAULT;

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE handoff_int SET v = v + 10000 WHERE MOD(id, 10) = 0"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE handoff_str SET v = v + 10000 WHERE MOD(n, 10) = 0"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "DELETE FROM handoff_int WHERE MOD(id, 7) = 0"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "DELETE FROM handoff_str WHERE MOD(n, 7) = 0"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO handoff_int (id, v) SELECT x, x FROM UNNEST(ARRAY_CONCAT([-1000], GENERATE_ARRAY(2000, 2019))) AS x"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO handoff_str (id, n, v) SELECT FORMAT('k%03d', x), x, x FROM UNNEST(GENERATE_ARRAY(200, 219)) AS x"

query IIII retry 24 backoff 5s
select count(*), sum(v), min(id), max(id) from t_handoff_int;
----
193 255711 -1000 2019

query IITT retry 24 backoff 5s
select count(*), sum(v), min(id), max(id) from t_handoff_str;
----
191 191248 k001 k219

statement ok
DROP TABLE t_handoff_int;

statement ok
DROP TABLE t_handoff_str;

