system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE inventory SET quantity = 999 WHERE id = 1"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "DELETE FROM inventory WHERE id = 4"

# Successive transactions on one row must apply in commit order.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE inventory SET quantity = 1 WHERE id = 2"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE inventory SET quantity = 2 WHERE id = 2"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE inventory SET quantity = 3 WHERE id = 2"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO empty_items (id, name) VALUES (1, 'first')"

