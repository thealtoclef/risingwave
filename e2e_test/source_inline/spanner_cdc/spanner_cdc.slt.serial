# =============================================================================
# PART 6: COLUMN TYPES
# =============================================================================

# --- 6A: scalars. Rows 1 and 2 are read by the snapshot; rows 3 and 4 carry the
# same values and arrive through the change stream. Each pair must read back
# identically, including INT64 max, NUMERIC beyond f64 precision, and NULLs.

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE scalars (id INT64 NOT NULL, b BOOL, i INT64, f FLOAT64, n NUMERIC, s STRING(MAX), j JSON, bin BYTES(MAX), d DATE, ts TIMESTAMP) PRIMARY KEY (id)"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO scalars (id, b, i, f, n, s, j, bin, d, ts) VALUES (1, true, 9223372036854775807, 0.1, NUMERIC '-1234567890.123456789', 'héllo', JSON '{\"a\":[1,2]}', b'\x00\xff', DATE '2024-02-29', TIMESTAMP '2024-03-04T05:06:07.123456Z'), (2, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)"

statement ok
CREATE TABLE t_scalars (*) WITH (
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'scalars';

query I retry 24 backoff 5s
select count(*) from t_scalars;
----
2

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO scalars (id, b, i, f, n, s, j, bin, d, ts) VALUES (3, true, 9223372036854775807, 0.1, NUMERIC '-1234567890.123456789', 'héllo', JSON '{\"a\":[1,2]}', b'\x00\xff', DATE '2024-02-29', TIMESTAMP '2024-03-04T05:06:07.123456Z'), (4, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)"

query IBIRTTTTTT retry 12 backoff 5s
select id, b, i, f, n, s, j, bin, d, ts from t_scalars order by id;
----
1 t 9223372036854775807 0.1 -1234567890.123456789 héllo {"a": [1, 2]} \x00ff 2024-02-29 2024-03-04 05:06:07.123456+00:00
2 NULL NULL NULL NULL NULL NULL NULL NULL NULL
3 t 9223372036854775807 0.1 -1234567890.123456789 héllo {"a": [1, 2]} \x00ff 2024-02-29 2024-03-04 05:06:07.123456+00:00
4 NULL NULL NULL NULL NULL NULL NULL NULL NULL

statement ok
DROP TABLE t_scalars;

# --- 6B: arrays. The snapshot must read ARRAY cells as typed lists, including
# NULL elements, NULL arrays and empty arrays. DATE is checked both as a column
# and as an array element. NULL elements are only used in INT64 and DATE arrays:
# the emulator crashes on commit when a change stream watches a STRING, BOOL or
# FLOAT64 array holding both a NULL and a non-NULL element.

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE arrays (id INT64 NOT NULL, a_i ARRAY<INT64>, a_f ARRAY<FLOAT64>, a_s ARRAY<STRING(MAX)>, a_b ARRAY<BYTES(MAX)>, a_ts ARRAY<TIMESTAMP>, a_d ARRAY<DATE>, a_n ARRAY<NUMERIC>, a_j ARRAY<JSON>, a_bool ARRAY<BOOL>, d DATE) PRIMARY KEY (id)"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO arrays (id, a_i, a_f, a_s, a_b, a_ts, a_d, a_n, a_j, a_bool, d) VALUES (1, [1, 9007199254740993, NULL], [1.5, 2.5], ['x', 'y'], [b'\x01\x02'], [TIMESTAMP '2024-03-04T05:06:07.123456Z'], [DATE '2024-02-29', NULL], [NUMERIC '12345678901234567.8'], [JSON '{\"k\":1}'], [true, false], DATE '2024-02-29'), (2, NULL, [], NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)"

statement ok
CREATE TABLE t_arrays (*) WITH (
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'arrays';

# INT64 elements beyond 2^53 must keep full precision.
query III retry 24 backoff 5s
select a_i[1], a_i[2], a_i[3] from t_arrays where id = 1;
----
1 9007199254740993 NULL

query RRTTT
select a_f[1], a_f[2], a_s[1], a_s[2], a_b[1] from t_arrays where id = 1;
----
1.5 2.5 x y \x0102

query TTTTTBB
select a_ts[1], a_d[1], a_d[2], a_n[1], a_j[1], a_bool[1], a_bool[2] from t_arrays where id = 1;
----
2024-03-04 05:06:07.123456+00:00 2024-02-29 NULL 12345678901234567.8 {"k": 1} t f

query T
select d from t_arrays where id = 1;
----
2024-02-29

# A NULL array stays NULL; an empty array is not NULL.
query BI
select a_i is null, cardinality(a_f) from t_arrays where id = 2;
----
t 0

statement ok
DROP TABLE t_arrays;

