control substitution on

# Spanner CDC end-to-end test, written for the Spanner emulator
# (`./risedev d spanner-emulator`; see README.md).
#
# One shared source reads a FOR ALL change stream. Each part checks one behaviour,
# and a table used by only one part is created and dropped inside it. Changes are
# checked with `retry`, so each step waits only as long as the data takes to arrive.

# =============================================================================
# PART 0: TEARDOWN
# Drop RisingWave objects left by an earlier run. Dropping a CDC source with
# CASCADE drops its tables. `setup` below recreates the Spanner database empty.
# =============================================================================

statement ok
DROP SOURCE IF EXISTS spanner_source CASCADE;

statement ok
DROP SOURCE IF EXISTS s CASCADE;

# =============================================================================
# PART 1: SPANNER FIXTURES
# users is filled before the change stream exists, so its rows reach RisingWave
# only through the snapshot. products and inventory are filled after, so their
# rows are in both the snapshot and the change stream.
# =============================================================================

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs setup

# users: STRING key.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE users (id STRING(MAX) NOT NULL, name STRING(MAX), email STRING(MAX), age INT64) PRIMARY KEY (id)"

# products: STRING key, for uneven (sampled) splits.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE products (id STRING(MAX) NOT NULL, name STRING(MAX), price FLOAT64, category STRING(MAX)) PRIMARY KEY (id)"

# inventory: INT64 key, for even (range) splits.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE inventory (id INT64 NOT NULL, name STRING(MAX), quantity INT64) PRIMARY KEY (id)"

# empty_items: no rows, so every backfill actor is idle.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE TABLE empty_items (id INT64 NOT NULL, name STRING(MAX)) PRIMARY KEY (id)"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO users (id, name, email, age) VALUES ('1', 'Alice', 'alice@example.com', 30), ('2', 'Bob', 'bob@example.com', 25)"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE CHANGE STREAM test_stream FOR ALL OPTIONS (retention_period = '7d', value_capture_type = 'NEW_ROW')"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO products (id, name, price, category) VALUES ('p1', 'Widget', 9.99, 'gadgets'), ('p2', 'Gizmo', 24.50, 'gadgets'), ('p3', 'Thingamajig', 4.99, 'misc')"

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO inventory (id, name, quantity) VALUES (1, 'Bolt', 100), (2, 'Nut', 200), (3, 'Washer', 150), (4, 'Screw', 300), (5, 'Nail', 250)"

# =============================================================================
# PART 2: CREATE SOURCE AND CREATE TABLE VALIDATION
# =============================================================================

statement error missing field `spanner.change_stream.name`
CREATE SOURCE s WITH (connector = 'spanner-cdc', spanner.project = 'test-project', spanner.instance = 'test-instance', database.name = 'test-database');

statement error change stream 'nonexistent_stream' does not exist
CREATE SOURCE s WITH (
    ${RISEDEV_SPANNER_WITH_OPTIONS_COMMON},
    spanner.change_stream.name = 'nonexistent_stream'
);

# Option values the change stream TVF or the retry loop cannot use.
statement error spanner.heartbeat_milliseconds must be between 1000 and 300000
CREATE SOURCE s WITH (
    ${RISEDEV_SPANNER_WITH_OPTIONS_COMMON},
    spanner.change_stream.name = 'test_stream',
    spanner.heartbeat_milliseconds = 999
);

statement error spanner.retry_backoff_ms must be greater than 0
CREATE SOURCE s WITH (
    ${RISEDEV_SPANNER_WITH_OPTIONS_COMMON},
    spanner.change_stream.name = 'test_stream',
    spanner.retry_backoff_ms = 0
);

# Spanner's default value capture type, OLD_AND_NEW_VALUES, omits unmodified
# columns on UPDATE, which would overwrite them with NULL.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE CHANGE STREAM old_new_stream FOR users"

statement error uses value_capture_type 'OLD_AND_NEW_VALUES', which is not supported
CREATE SOURCE s WITH (
    ${RISEDEV_SPANNER_WITH_OPTIONS_COMMON},
    spanner.change_stream.name = 'old_new_stream'
);

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "DROP CHANGE STREAM old_new_stream"

# A PostgreSQL-dialect database is rejected before any GoogleSQL query fails on it
# with a syntax error. Emulator only: the script creates the database.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs create-postgresql-database

statement error uses the POSTGRESQL dialect, which is not supported
CREATE SOURCE s WITH (
    connector = 'spanner-cdc',
    spanner.emulator_host = '${SPANNER_EMULATOR_HOST}',
    spanner.project = '${SPANNER_PROJECT}',
    spanner.instance = '${SPANNER_INSTANCE}',
    database.name = 'test-postgresql-database',
    spanner.change_stream.name = 'test_stream'
);

# A change stream that watches only some columns cannot back a table that has the
# others: an unwatched column would be overwritten with NULL on every update.
system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "CREATE CHANGE STREAM partial_columns_stream FOR users(name) OPTIONS (value_capture_type = 'NEW_ROW')"

statement ok
CREATE SOURCE s WITH (
    ${RISEDEV_SPANNER_WITH_OPTIONS_COMMON},
    spanner.change_stream.name = 'partial_columns_stream'
);

statement error change stream 'partial_columns_stream' does not watch columns
CREATE TABLE t_users_partial (*) FROM s TABLE 'users';

statement error change stream 'partial_columns_stream' does not watch table 'products'
CREATE TABLE t_products_partial (*) FROM s TABLE 'products';

# A table with only the watched columns is accepted; the key is always watched.
statement ok
CREATE TABLE t_users_partial (id varchar primary key, name varchar) FROM s TABLE 'users';

statement ok
DROP SOURCE s CASCADE;

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs ddl "DROP CHANGE STREAM partial_columns_stream"

# =============================================================================
# PART 3: SHARED SOURCE AND BACKFILL
# Spanner tables always use backfill v2. num_rows_per_split = 2 forces several
# splits with little data.
# =============================================================================

statement ok
CREATE SOURCE spanner_source WITH (
    ${RISEDEV_SPANNER_WITH_OPTIONS_COMMON},
    spanner.change_stream.name = 'test_stream',
    spanner.heartbeat_milliseconds = 5000,
    auto.schema.change = 'true'
);

# Default backfill options (parallelism 1).
statement ok
CREATE TABLE t_users (*) FROM spanner_source TABLE 'users';

statement ok
CREATE TABLE t_products (*) WITH (
    backfill.parallelism = 3,
    backfill.num_rows_per_split = 2,
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'products';

statement ok
CREATE TABLE t_inventory (*) WITH (
    backfill.parallelism = 3,
    backfill.num_rows_per_split = 2,
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'inventory';

statement ok
CREATE TABLE t_empty (*) WITH (
    backfill.parallelism = 3,
    spanner.databoost.enabled = 'false',
)
FROM spanner_source
TABLE 'empty_items';

query TT retry 24 backoff 5s
select id, name from t_users order by id;
----
1 Alice
2 Bob

query TT retry 24 backoff 5s
select id, name from t_products order by id;
----
p1 Widget
p2 Gizmo
p3 Thingamajig

query IT retry 24 backoff 5s
select id, name from t_inventory order by id;
----
1 Bolt
2 Nut
3 Washer
4 Screw
5 Nail

# Every backfill completes, including one whose actors never see a row: its
# splits collapse into a single finished one.
query TI retry 24 backoff 5s
SELECT t.name, p.split_completed_count FROM rw_catalog.rw_cdc_progress p JOIN rw_catalog.rw_tables t ON p.job_id = t.id WHERE t.name IN ('t_users', 't_products', 't_inventory', 't_empty') ORDER BY t.name;
----
t_empty 1
t_inventory 1
t_products 1
t_users 1

query T
select column_name from information_schema.columns where table_name = 't_users' order by ordinal_position;
----
id
name
email
age

query T
select column_name from information_schema.columns where table_name = 't_inventory' order by ordinal_position;
----
id
name
quantity

# =============================================================================
# PART 4: CHANGE STREAM - INSERT, UPDATE AND DELETE ON EVERY TABLE
# =============================================================================

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "INSERT INTO users (id, name, email, age) VALUES ('3', 'Charlie', 'charlie@example.com', 35), ('4', 'Diana', 'diana@example.com', 28)"

system ok
