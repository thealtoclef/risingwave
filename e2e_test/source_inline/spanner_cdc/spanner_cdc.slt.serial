# =============================================================================
# PART 9: ALTER SOURCE
# An alter-on-fly option rebuilds the reader, which resumes every partition from
# its saved progress; other options are rejected.
# =============================================================================

statement error is not allowed to be altered on the fly
ALTER SOURCE spanner_source CONNECTOR WITH (spanner.change_stream.name = 'other_stream');

statement ok
ALTER SOURCE spanner_source CONNECTOR WITH (spanner.heartbeat_milliseconds = 3000);

system ok
e2e_test/source_inline/spanner_cdc/prepare-data.rs dml "UPDATE users SET age = 41 WHERE id = '6'"

query TI retry 12 backoff 5s
select id, age from t_users where id = '6';
----
6 41

# =============================================================================
# PART 10: RECOVERY
# Changes committed while the cluster recovers must still arrive: the source
# resumes from its saved offsets. Keyed tables absorb any replayed change, so
# each table must end with exactly the expected rows.
# =============================================================================

statement ok
recover;

system ok
